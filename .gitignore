# Python venv
.venv/

# Python bytecode caches
__pycache__/
*.py[co]

# Pytest cache
.pytest_cache/

# Playwright MCP cache
.playwright-mcp/

# Локальные настройки Claude Code (личное у каждого пользователя)
.claude/settings.local.json

# Воркtri Claude Code — служебные рабочие копии репо (`git worktree`),
# создаются автоматически и не должны попадать в коммиты.
.claude/worktrees/

# Бизнес-данные тенантов: всё под private/, кроме скелета _template/.
# Каждый тенант — отдельный приватный git-репозиторий, клонируется в
# private/<name>/ и не должен попадать в публичный репо движка.
/private/*
!/private/_template/
!/private/.gitkeep
